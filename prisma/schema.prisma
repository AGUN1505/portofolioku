// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ADMIN & AUTHENTICATION
// ============================================================

model Admin {
  id             String   @id @default(cuid())
  username       String   @unique
  passwordHash   String
  email          String?  @unique
  sessionVersion Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("admins")
}

// ============================================================
// HERO SECTION
// ============================================================

model HeroProfile {
  id         String   @id @default("singleton")
  name       String
  tagline    String   @db.Text
  bio        String   @db.Text
  country    String
  code       String
  timezone   String
  discipline String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("hero_profiles")
}

model Role {
  id        String   @id @default(cuid())
  title     String
  primary   Boolean  @default(false)
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model EngineeringNode {
  id          String   @id @default(cuid())
  tag         String
  title       String
  description String   @db.Text
  stack       String?  @db.Text
  highlighted Boolean  @default(false)
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("engineering_nodes")
}

// ============================================================
// ABOUT SECTION
// ============================================================

model AboutProfile {
  id                 String   @id @default("singleton")
  heading            String
  quote              String   @db.Text
  primaryNarrative   String   @db.Text
  secondaryNarrative String   @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("about_profiles")
}

model Domain {
  id        String   @id @default(cuid())
  index     String
  title     String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("domains")
}

model Pillar {
  id          String   @id @default(cuid())
  index       String
  title       String
  description String   @db.Text
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pillars")
}

// ============================================================
// PROJECTS SECTION
// ============================================================

model Project {
  id           String    @id @default(cuid())
  title        String
  category     String
  description  String    @db.Text
  technologies Json
  thumbnailUrl String?
  projectUrl   String?
  githubUrl    String?
  published    Boolean   @default(false)
  publishedAt  DateTime?
  order        Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("projects")
}

// ============================================================
// EXPERIENCE SECTION
// ============================================================

model Experience {
  id          String    @id @default(cuid())
  role        String
  institution String
  track       String
  description String?   @db.Text
  startDate   DateTime?
  endDate     DateTime?
  order       Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("experiences")
}

// ============================================================
// SKILLS SECTION
// ============================================================

model SkillCategory {
  id        String   @id @default(cuid())
  title     String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  skills    Skill[]

  @@map("skill_categories")
}

model Skill {
  id         String        @id @default(cuid())
  name       String
  categoryId String
  category   SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  order      Int
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@map("skills")
}

// ============================================================
// CONTACT SECTION
// ============================================================

model ContactProfile {
  id          String   @id @default("singleton")
  heading     String
  ctaLabel    String
  description String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("contact_profiles")
}

model ContactChannel {
  id        String   @id @default(cuid())
  label     String
  value     String   @db.Text
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_channels")
}
